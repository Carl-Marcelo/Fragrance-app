# Copy this file to `.env.local` for local development and fill in your own values.
# In Vercel, add the same variables under Project → Settings → Environment Variables.

# -----------------------------------------------------------------------------
# Browser (public) — anything prefixed VITE_ is shipped to every visitor.
# The anon key only grants what Row Level Security allows.
# NEVER put a service_role / secret key in a VITE_ variable.
# -----------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / publishable key
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the public URL of the deployed site (used for password-reset redirects).
# Leave blank to use the current browser origin.
VITE_SITE_URL=

# -----------------------------------------------------------------------------
# Server only — read by the functions in api/ (fragrance database proxy).
# These never reach the browser.
# -----------------------------------------------------------------------------

# Fragella API key (https://api.fragella.com). Leave blank to disable live search.
FRAGELLA_API_KEY=

# Supabase service-role / secret key, used ONLY by the proxy to enforce search
# limits (public.consume_discovery_quota). Required in production for live search.
SUPABASE_SERVICE_ROLE_KEY=

# Search safeguards (optional; defaults shown)
DISCOVER_MONTHLY_CAP=1000
DISCOVER_RATE_PER_MINUTE=20
DISCOVER_RATE_PER_DAY=300

# Optional: any random string; salts the hashed visitor IPs used for rate limiting.
RATE_LIMIT_SALT=
